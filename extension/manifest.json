{
  "manifest_version": 3,
  "name": "Golf Raffle Autofill",
  "version": "1.0",
  "description": "Autofills golf raffle and giveaway forms with one click.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Autofill Raffle"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
